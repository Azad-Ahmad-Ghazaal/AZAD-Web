#!/bin/sh
xsetroot -solid "#101318" 2>/dev/null || true

# AZAD -> MUAG control uses a local Unix socket only; no network listener.
if command -v muag-actiond >/dev/null 2>&1; then
    muag-actiond >/var/log/muag-actiond.log 2>&1 &
fi

if command -v muag-shell >/dev/null 2>&1; then
    muag-shell &
else
    xterm &
fi

exec openbox-session
